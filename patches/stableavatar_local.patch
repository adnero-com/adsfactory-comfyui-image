@@ -918,6 +918,10 @@ def apply_scale_to_latent(latent, mean, std_inv):
     std_inv: StableAvatar VAE的1/std参数 [C]
     """
     # 反标准化: z = z / (1/std) + mean
+    # Device/dtype alignment: the latent arrives on cuda while mean/std_inv can sit on
+    # cpu (offload path) -> "Expected all tensors to be on the same device" (job 1014).
+    mean = mean.to(device=latent.device, dtype=latent.dtype)
+    std_inv = std_inv.to(device=latent.device, dtype=latent.dtype)
     scaled_latent = latent / std_inv.view(1, -1, 1, 1, 1) + mean.view(1, -1, 1, 1, 1)
     return scaled_latent
 
